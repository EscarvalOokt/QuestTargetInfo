<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>QuestTargetInfo</RootNamespace>
        <AssemblyName>QuestTargetInfo</AssemblyName>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CurrentRimWorldVersion>1.7</CurrentRimWorldVersion>
        <Version>2.1.0</Version>
        <AssemblyVersion>2.1.0.0</AssemblyVersion>
        <FileVersion>2.1.0.0</FileVersion>
        <Description>Travel information for RimWorld world targets.</Description>
        <Authors>Escarval</Authors>
        <Copyright>Copyright © Escarval 2025–2026</Copyright>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="QuestTargetInfo.Tests"/>
        <HistoricalModVersion Include="1.6"
                              Sha256="e03761ca6254364d5d165f5eb58767d842059940701a2d4ff38a4fec0a944d72"/>
    </ItemGroup>

    <Import Project="..\QuestTargetInfo.Local.props"
            Condition="Exists('..\QuestTargetInfo.Local.props')"/>

    <PropertyGroup>
        <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RIMWORLD_INSTALL_DIR)</RimWorldManagedDir>
        <HarmonyDllPath Condition="'$(HarmonyDllPath)' == ''">$(HARMONY_DLL)</HarmonyDllPath>
        <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    </PropertyGroup>

    <Target Name="ValidateLocalConfiguration"
            BeforeTargets="ResolveReferences">
        <Error Condition="'$(RimWorldManagedDir)' == ''"
               Text="RimWorldManagedDir is not configured. Create src\QuestTargetInfo.Local.props from docs\QuestTargetInfo.Local.props.example and set the RimWorld 1.7 directory containing Assembly-CSharp.dll and UnityStubs.dll."/>
        <Error Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
               Text="Assembly-CSharp.dll was not found in '$(RimWorldManagedDir)'. Update src\QuestTargetInfo.Local.props."/>
        <Error Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)\UnityStubs.dll')"
               Text="UnityStubs.dll was not found in '$(RimWorldManagedDir)'. Use the RimWorld 1.7 game directory."/>
        <Error Condition="'$(DeployToGame)' != 'true' and '$(DeployToGame)' != 'false'"
               Text="DeployToGame must be true or false. Ordinary builds and tests do not deploy to the game."/>
        <Error Condition="'$(HarmonyDllPath)' == '' or !Exists('$(HarmonyDllPath)')"
               Text="Set HarmonyDllPath to the Harmony DLL loaded by RimWorld 1.7 in src/QuestTargetInfo.Local.props, or set HARMONY_DLL."/>
    </Target>

    <ItemGroup Condition="'$(RimWorldManagedDir)' != ''">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityStubs">
            <HintPath>$(RimWorldManagedDir)\UnityStubs.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(HarmonyDllPath)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Settings\"/>
    </ItemGroup>

    <Import Project="..\..\build\ModDeployment.targets"/>
</Project>
