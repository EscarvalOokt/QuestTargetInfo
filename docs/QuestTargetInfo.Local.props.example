<Project>
    <PropertyGroup>
        <!-- RimWorld 1.7 directory containing Assembly-CSharp.dll and UnityStubs.dll.
             On Windows this is the game root, not RimWorldWin64_Data/Managed. -->
        <RimWorldManagedDir>C:\Path\To\RimWorld</RimWorldManagedDir>

        <!-- Use the assembly selected by Harmony's LoadFolders.xml for RimWorld 1.7. -->
        <HarmonyDllPath>C:\Path\To\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyDllPath>

        <!-- Optional for ordinary build/test. Close RimWorld before deployment.
             Use an absolute path ending in Current\Assemblies with this casing,
             then build with -p:DeployToGame=true. Deployment replaces managed
             content directories and copies the complete mod. A clean external
             staging directory may be used instead of the game installation. -->
        <!-- <RimWorldModAssembliesDir>C:\Path\To\RimWorld\Mods\QuestTargetInfo\Current\Assemblies</RimWorldModAssembliesDir> -->
    </PropertyGroup>
</Project>